# =============================================================================
#  BIFROST - valores del laboratorio
#  UNICA FUENTE DE VERDAD. Ningun script debe repetir estos literales.
#
#  Formato:  CLAVE="valor"   (sin espacios alrededor del '=', sin comentarios
#                             al final de la linea)
#
#  Lo consumen:
#    - bifrost.ps1 / bifrost.sh          (operacion del laboratorio)
#    - provision/*.sh                    (configuracion de las VMs Linux)
#    - exploits/log4shell/*.sh           (cadena del puente 1)
#    - tenable/tenable_scan.py           (escaneo)
#    - windows/*.ps1                     (configuracion de las VMs Windows)
#
#  Si cambias un valor aqui, cambia en todas partes. Ver GUIDE.md (apendice de valores).
# =============================================================================

# --- Identidad ---------------------------------------------------------------
BIFROST_VERSION="1.1.0"
BIFROST_LAB_NAME="Bifrost"

# --- Red aislada -------------------------------------------------------------
# Todo el laboratorio vive en esta red. El atacante solo alcanza BIFROST_IP_WEB.
# Es una red HOST-ONLY: no hay router ni salida a internet, asi que el gateway
# es nominal (no rutea nada). El .1 es solo la convencion de VMware para el
# adaptador del host; el atacante puede estar en cualquier IP libre del segmento.
BIFROST_NETWORK="10.10.0.0"
BIFROST_PREFIX="24"
BIFROST_GATEWAY="10.10.0.1"

# --- Direccionamiento --------------------------------------------------------
# El atacante es el HOST (ParrotOS) a traves de su interfaz host-only (VMnet1).
BIFROST_IP_ATTACKER="10.10.0.66"
BIFROST_IP_SCANNER="10.10.0.10"
BIFROST_IP_WEB="10.10.0.20"
BIFROST_IP_DC="10.10.0.30"
BIFROST_IP_WS="10.10.0.31"

# --- Usuarios de sistema -----------------------------------------------------
BIFROST_SSH_USER="bifrost"
BIFROST_SCANNER_USER="bifrost"

# --- Dominio -----------------------------------------------------------------
BIFROST_DOMAIN="corp.local"
BIFROST_NETBIOS="CORP"
BIFROST_DOMAIN_ADMIN="Administrator"
BIFROST_DOMAIN_ADMIN_PASS="Bifrost-Admin-2026!"
BIFROST_DSRM_PASS="Bifrost-DSRM-2026!"

# --- Cuentas del escenario (ficticias, solo laboratorio) ---------------------
BIFROST_SVC_USER="svc_backup"
BIFROST_SVC_PASS="Verano2024!"
BIFROST_APP_USER="svc_app"
BIFROST_APP_PASS="Bifrost2026!"

# --- Contenido de las VMs Windows -------------------------------------------
# Carpeta "joya de la corona" que el atacante lee al final de la cadena.
BIFROST_CROWN_JEWEL="C:\Corp\Finanzas"
# Carpeta compartida de ws01 con credenciales senuelo.
BIFROST_SHARE_PATH="C:\Compartido"

# --- Puertos -----------------------------------------------------------------
BIFROST_SOLR_PORT="8983"
BIFROST_LDAP_PORT="1389"
BIFROST_HTTP_PORT="8000"
BIFROST_REVSHELL_PORT="4444"
BIFROST_PROBE_PORT="9998"

# --- Componente vulnerable ---------------------------------------------------
BIFROST_SOLR_VERSION="8.11.0"

# --- Operacion del laboratorio -----------------------------------------------
# Ruta de las VMs, relativa a la raiz del repo o absoluta.
BIFROST_VM_DIR="./vms"
# Tipo de hipervisor para vmrun: ws (Workstation) | fusion (Fusion) | player
BIFROST_VMWARE_TYPE="ws"
# Ruta a vmrun. Vacio = autodeteccion (PATH y rutas conocidas).
BIFROST_VMRUN=""
# Etiqueta del snapshot al que se revierte antes de cada ensayo.
BIFROST_SNAPSHOT="pre-demo"
# Espacio en disco que se exige para el laboratorio completo.
BIFROST_DISK_BUDGET_GB="100"

# --- Tenable One -------------------------------------------------------------
BIFROST_TENABLE_BASE_URL="https://cloud.tenable.com"
BIFROST_TENABLE_POLICY="Bifrost-Demo"
# Vacio = $HOME/.bifrost/tenable.json
BIFROST_TENABLE_KEYS_FILE=""
